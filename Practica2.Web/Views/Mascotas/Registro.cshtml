@model MascotaRegistroViewModel
@{
    ViewData["Title"] = "Registro de Mascotas";
    ViewData["Subtitulo"] = "Todos los campos son obligatorios. Cada cliente puede tener como máximo 2 mascotas de la misma especie.";
}

@if (Model.ClientesCargados && Model.Clientes.Count == 0)
{
    <div class="alert-custom alert-custom-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill alert-custom-icon"></i>
        <div class="alert-custom-content">
            No hay clientes registrados. Primero registre uno en
            <a asp-controller="Clientes" asp-action="Registro" class="alert-link">Registro de Clientes</a>.
        </div>
    </div>
}

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card border-light shadow-sm p-4">
            <h2 class="card-title mb-4">Datos de la mascota</h2>

            <form asp-controller="Mascotas" asp-action="Registro" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert-custom alert-custom-danger resumen-validacion" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="IdCliente" class="form-label-custom"></label>
                    <select asp-for="IdCliente" asp-items="Model.Clientes" class="form-select-custom">
                        <option value="">Seleccione un cliente</option>
                    </select>
                    <span asp-validation-for="IdCliente" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label-custom"></label>
                    <input asp-for="Nombre" class="form-control-custom" placeholder="Nombre de la mascota" autocomplete="off" />
                    <span asp-validation-for="Nombre" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label asp-for="Especie" class="form-label-custom"></label>
                        <input asp-for="Especie" class="form-control-custom" placeholder="Ej.: Perro" autocomplete="off" />
                        <span asp-validation-for="Especie" class="form-feedback-custom invalid-custom"></span>
                    </div>
                    <div class="col-12 col-md-6 mb-3">
                        <label asp-for="Raza" class="form-label-custom"></label>
                        <input asp-for="Raza" class="form-control-custom" placeholder="Ej.: Labrador" autocomplete="off" />
                        <span asp-validation-for="Raza" class="form-feedback-custom invalid-custom"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Peso" class="form-label-custom"></label>
                    <input asp-for="Peso" type="number" step="0.01" min="0.01" max="999999.99" class="form-control-custom" placeholder="Ej.: 12.50" />
                    <span asp-validation-for="Peso" class="form-feedback-custom invalid-custom"></span>
                </div>

                <button type="submit" class="btn-custom btn-custom-primary">
                    <i class="bi bi-clipboard-check-fill"></i> Registrar mascota
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
