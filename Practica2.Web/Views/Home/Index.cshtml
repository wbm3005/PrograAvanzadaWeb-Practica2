@{
    ViewData["Title"] = "Inicio";
    ViewData["Subtitulo"] = "Sistema para registrar clientes y sus mascotas.";
}

<div class="card border-light shadow-sm p-4">
    <div class="d-flex align-items-start gap-3">
        <div class="text-lime empty-state-icon inicio-icono">
            <i class="bi bi-heart-pulse-fill"></i>
        </div>
        <div>
            <h2 class="h4 mb-2">¿Qué desea hacer hoy?</h2>
            <p class="text-muted-green mb-0">
                Utilice el menú lateral para registrar clientes, registrar sus mascotas
                o consultar todas las mascotas registradas.
            </p>
        </div>
    </div>
</div>
